config SPI_CC13X4_CC26X4
	bool "TI SimpleLink CC13x4 / CC26x4 SPI driver"
	default y
	depends on DT_HAS_TI_CC13X4_CC26X4_SPI_ENABLED
	select PINCTRL
	help
	  Enable support for the TI SimpleLink CC13x4 / CC26x4 SPI peripheral.
	  Uses interrupt-driven FIFO ping-pong (TX fill + RX drain in ISR).

config SPI_CC13X4_CC26X4_DMA_DRIVEN
	bool "DMA support for TI CC13X4_CC26X4 SPI devices"
	depends on SPI_CC13X4_CC26X4
	select DMA
	help
	  DMA driven mode offloads data transfer tasks from the CPU
