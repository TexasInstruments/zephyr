if SOC_SERIES_CC13X4_CC26X4

config CPU_FREQUENCY
	int
	default 48000000

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 32768

# Note that when using the RTC as system clock, this needs to be 32768
# to reduce truncation errors from accumulating due to conversion to/from
# time, ticks, and HW cycles
config SYS_CLOCK_TICKS_PER_SEC
	default 32768

config NUM_IRQS
	default 43

config CC13X4_CC26X4_RTC_TIMER
	default y

config CORTEX_M_SYSTICK
	default n

endif # SOC_SERIES_CC13X4_CC26X4
