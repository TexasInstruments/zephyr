config CC13X4_CC26X4_RTC_TIMER
	bool "TI SimpleLink CC13x4/CC26x4 RTC system clock timer"
	default y
	depends on DT_HAS_TI_CC13X4_CC26X4_RTC_TIMER_ENABLED
	select TICKLESS_CAPABLE
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	help
	  This module implements a kernel device driver for the TI SimpleLink
	  CC13X4_CC26X4 series Real Time Counter and provides the standard
	  "system clock driver" interfaces.
