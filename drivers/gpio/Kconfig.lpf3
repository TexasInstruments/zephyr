config GPIO_LPF3
	bool "TI SimpleLink LPF3 GPIO driver"
	default y
	depends on DT_HAS_TI_LPF3_GPIO_ENABLED
	help
	  Enable the TI SimpleLink LPF3 GPIO driver (CC23XX/CC27XX).
