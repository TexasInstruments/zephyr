if SOC_SERIES_CC23X0

	config CPU_FREQUENCY
		int
		default 48000000

	config SYS_CLOCK_HW_CYCLES_PER_SEC
		default 1000000

	config SYS_CLOCK_TICKS_PER_SEC
		default 10000

config NUM_IRQS
	default 19

config BUILD_OUTPUT_BIN
	default n

# The entropy driver must be ready before the Mbed TLS SYS_INIT
# (KERNEL_INIT_PRIORITY_DEFAULT), so psa_crypto_init() seeds its DRBG
# from it. It needs power_initialize(), which runs at priority 30.
config ENTROPY_INIT_PRIORITY
	default 39

endif
