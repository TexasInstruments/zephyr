config PINCTRL_LPF3
	bool "TI SimpleLink LPF3 pinctrl driver"
	default y
	depends on DT_HAS_TI_LPF3_PINCTRL_ENABLED
	help
	  Enable the TI SimpleLink LPF3 pinctrl driver (CC23X0/CC27XX).
