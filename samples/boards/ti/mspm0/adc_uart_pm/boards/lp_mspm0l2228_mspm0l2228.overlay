#include <zephyr/dt-bindings/adc/adc.h>

/ {
	aliases {
		wake-timer = &counterg0;
	};

	chosen {
		zephyr,system-timer-companion = &counterg0;
	};

	zephyr,user {
		io-channels = <&adc0 0>;
	};
};

&cpu0 {
	cpu-power-states = <&run0>;
};

/* Timer G0 uses ULPCLK with a /256 prescaler and /8 divider. */
&timg0 {
	ti,clk-div = <8>;
	status = "okay";

	counterg0: counterg0 {
		status = "okay";
	};
};

/* ADC0.0 is available on PA27. */
&adc0 {
	pinctrl-0 = <&analog_pa27>;
	pinctrl-names = "default";
	status = "okay";
	zephyr,pm-device-runtime-auto;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 4)>;
		zephyr,resolution = <12>;
	};
};

&uart0 {
	zephyr,pm-device-runtime-auto;
};
